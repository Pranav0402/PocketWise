# Copy to .env for local development. Generate a unique secret before deployment.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
APP_ENVIRONMENT=development
AUTO_MIGRATE=true
ACCESS_TOKEN_MINUTES=1440
DATABASE_URL=sqlite:///./pocketwise.db
CORS_ORIGINS=http://localhost:5173

# Leave blank to use the same-origin /api path (Vite proxies it during development).
VITE_API_URL=

# Rules run locally in the backend; optional Ollama is loopback-only.
ASSISTANT_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
